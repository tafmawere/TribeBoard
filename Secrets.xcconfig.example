// Copy to `Secrets.xcconfig` next to this file (Secrets.xcconfig is gitignored) and set your keys.
// Gray map + blue location dot: enable billing, enable "Maps SDK for iOS" (not only Places/Geocoding).
// iOS key restriction bundle id must match Xcode exactly, e.g. net.dataenvy.tribeboard.ios (Debug/Release target).
GOOGLE_MAPS_API_KEY = YOUR_API_KEY_HERE

// Google Sign-In (iOS OAuth client ID from Google Cloud Console — NOT the Supabase web client ID).
// Create an iOS OAuth client for your bundle id, then set both values below.
// Example client id: 123456789012-abcdef.apps.googleusercontent.com
// Example reversed URL scheme: com.googleusercontent.apps.123456789012-abcdef
GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID_URL_SCHEME = com.googleusercontent.apps.YOUR_IOS_CLIENT_ID

// Web OAuth client (Google Cloud Console → Credentials → Web application). Same client ID configured in Supabase Auth → Google.
// Required as serverClientID so Google issues an ID token Supabase accepts. List web + iOS client IDs in Supabase (web first).
GOOGLE_WEB_CLIENT_ID = YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

// Supabase project (Settings → API). Anon/public key only — never the service role key.
SUPABASE_URL = YOUR_SUPABASE_URL
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
